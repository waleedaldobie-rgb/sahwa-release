{
  "name": "sahwa-tailoring",
  "private": true,
  "version": "1.3.6",
  "description": "نظام إدارة الخياطة الرجالية صهوة",
  "author": "Sahwa Tailoring",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:electron:renderer": "cross-env ELECTRON_BUILD=true npm run build",
    "preview": "vite preview",
    "build:electron": "node scripts/build-electron.mjs",
    "perf:report": "node scripts/performance-report.mjs",
    "perf:v130": "npm run build:electron && electron --no-sandbox scripts/performance-v130.integration.cjs",
    "electron:dev": "npm run build:electron && concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "test:visual:desktop": "node scripts/desktop-visual-viewport-check.mjs",
    "test:print:desktop": "cross-env DESKTOP_VISUAL_STATES=print node scripts/desktop-visual-viewport-check.mjs",
    "test:p2:boundaries": "vitest run src/__tests__/p2BoundaryValues.test.ts",
    "dist": "npm run build:electron:renderer && npm run build:electron && electron-builder --config electron-builder.json --win",
    "dist:windows": "npm run build:electron:renderer && npm run build:electron && electron-builder --config electron-builder.json --win",
    "clean": "rm -rf dist server.js",
    "typecheck:electron": "tsc -p tsconfig.electron.json --pretty false",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --pretty false",
    "eslint": "eslint src",
    "lint": "npm run typecheck:domain && npm run typecheck:adapters && npm run typecheck:electron && npm run typecheck:renderer && npm run eslint",
    "check:legacy-ipc": "node scripts/check-legacy-ipc.mjs",
    "test:legacy-ipc": "node scripts/check-legacy-ipc.smoke.mjs",
    "typecheck:domain": "tsc -p tsconfig.domain.json --pretty false",
    "typecheck:adapters": "tsc -p tsconfig.adapters.json --pretty false",
    "quality:domain": "npm run typecheck:domain",
    "quality:adapters": "npm run typecheck:adapters",
    "quality": "npm run quality:domain && npm run quality:adapters && npm run lint",
    "test": "vitest run",
    "test:integration": "npm run build:electron && electron --no-sandbox scripts/integration-regression.cjs",
    "test:sqlite:indexes": "npm run build:electron && electron --no-sandbox scripts/sqlite-index-performance.integration.cjs",
    "test:migration:r006": "npm run build:electron && electron --no-sandbox scripts/r006-migration-008.integration.cjs",
    "test:migration:r007": "npm run build:electron && electron --no-sandbox scripts/r007-restore-policy.integration.cjs",
    "test:integrity:r010": "npm run build:electron && electron --no-sandbox scripts/r010-integrity-orphans.integration.cjs",
    "test:integration:r008-r009": "npm run build:electron && electron --no-sandbox scripts/r008-r009.integration.cjs",
    "test:integration:r009": "npm run build:electron && electron --no-sandbox scripts/r009-deletion.integration.cjs",
    "test:integration:r011": "npm run build:electron && electron --no-sandbox scripts/r011-cancelled-payment.integration.cjs",
    "test:integration:r015": "npm run build:electron && electron --no-sandbox scripts/r015-payment-path-contract.integration.cjs",
    "test:integration:customer-credit": "npm run build:electron && electron --no-sandbox scripts/customer-credit-lifecycle.integration.cjs",
    "test:integration:customer-credit-restore": "npm run build:electron && electron --no-sandbox scripts/customer-credit-backup-restore.integration.cjs",
    "test:integration:r012": "npm run build:electron && electron --no-sandbox scripts/r012-purchase-cash-integrity.integration.cjs",
    "test:integration:production-audit": "npm run build:electron && electron --no-sandbox scripts/audit-production-accounting.integration.cjs",
    "test:contract:r014": "vitest run src/__tests__/r014CatalogQuantityContract.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.59.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  }
}
