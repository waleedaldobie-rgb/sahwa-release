{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/electron/**/*",
    "src/services/shared/**/*",
    "src/domain/**/*",
    "src/types.ts"
  ]
}
